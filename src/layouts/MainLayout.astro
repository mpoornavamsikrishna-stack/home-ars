---
import Header from "../components/Header.astro";
import PriceTicker from "../components/PriceTicker.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import MobileActionBar from "../components/MobileActionBar.astro";
import SEO from "../components/SEO.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = "/og-image.jpg", noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <SEO title={title} description={description} image={image} noindex={noindex} />

    <!-- Preconnect to Google Fonts for faster first paint -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="/#home" class="skip-link">Skip to main content</a>
    <Header />
    <PriceTicker />
    <slot />
    <Footer />
    <WhatsAppButton />
    <MobileActionBar />

    <style>
      .skip-link {
        position: absolute;
        top: -100px;
        left: var(--sp-4);
        z-index: 200;
        background: var(--orange-500);
        color: #fff;
        padding: 10px 16px;
        border-radius: var(--radius-sm);
        font-weight: 600;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 12px;
      }
    </style>
  </body>
</html>

