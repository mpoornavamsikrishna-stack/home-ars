---
import { telHref, whatsappHref } from "../data/business";
---

<section class="cta" id="cta" aria-labelledby="cta-heading">
  <div class="container cta-inner">
    <h2 id="cta-heading">Need Appliance Repair?</h2>
    <p class="cta-text">
      Don't let a faulty appliance disrupt your day. Contact SVPHome ARS to schedule a service visit.
    </p>

    <div class="cta-buttons">
      <a href={telHref()} class="btn btn-outline">Call Now</a>
      <a href={whatsappHref()} class="btn btn-ghost-blue" target="_blank" rel="noopener">WhatsApp Us</a>
      <a href="/#booking" class="btn btn-cta">Book a Service</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: linear-gradient(180deg, var(--navy-900) 0%, var(--navy-700) 100%);
    padding: var(--sp-8) 0;
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-inner h2 {
    color: #fff;
    font-size: 28px;
    letter-spacing: -0.3px;
    max-width: 22ch;
  }

  .cta-text {
    margin-top: var(--sp-3);
    font-size: 15.5px;
    color: rgba(255, 255, 255, 0.78);
    max-width: 52ch;
  }

  .cta-buttons {
    margin-top: var(--sp-6);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--sp-3);
    width: 100%;
    max-width: 340px;
  }

  .cta-buttons .btn {
    font-size: 16px;
    padding: 15px 24px;
  }

  @media (min-width: 640px) {
    .cta-buttons {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      width: auto;
      max-width: none;
      flex-wrap: wrap;
    }

    .cta-buttons .btn {
      width: auto;
    }
  }

  @media (min-width: 900px) {
    .cta-inner h2 {
      font-size: 36px;
    }
  }
</style>
