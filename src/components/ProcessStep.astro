---
interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<li class="process-step">
  <span class="step-node" aria-hidden="true">{number}</span>
  <div class="step-content">
    <h3 class="step-title">{title}</h3>
    <p class="step-description">{description}</p>
  </div>
</li>

<style>
  /* Mobile-first: a stacked card with the number as a badge */
  .process-step {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    background: var(--bg-white);
    border: 1px solid var(--line-200);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
    box-shadow: var(--shadow-sm);
  }

  .step-node {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--navy-900);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: -0.2px;
  }

  .step-title {
    font-size: 16px;
    margin-bottom: 4px;
  }

  .step-description {
    font-size: 14px;
    color: var(--charcoal-600);
  }

  /* Desktop: timeline node, connected by a line drawn on the parent list */
  @media (min-width: 900px) {
    .process-step {
      flex-direction: column;
      align-items: center;
      text-align: center;
      background: transparent;
      border: none;
      box-shadow: none;
      padding: 0 var(--sp-4);
      position: relative;
      z-index: 1;
    }

    .step-node {
      margin-bottom: var(--sp-4);
      box-shadow: 0 0 0 6px var(--bg-light);
    }

    .step-description {
      max-width: 26ch;
    }
  }
</style>
