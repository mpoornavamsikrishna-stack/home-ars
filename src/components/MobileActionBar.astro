---
import { telHref, whatsappHref } from "../data/business";
---

<nav class="mobile-action-bar" aria-label="Quick actions">
  <a href={telHref()} class="action-item">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path
        d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.5c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8z"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span>Call</span>
  </a>

  <a href={whatsappHref()} class="action-item" target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path
        d="M17.5 14.4c-.3-.1-1.7-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.1.2-.3.3-.4.1-.2 0-.4 0-.5-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3 4.8 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.1-.2-.2-.5-.3z"
        fill="currentColor"></path>
      <path
        d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.5 5.3L2 22l4.8-1.5c1.5.9 3.3 1.3 5.2 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2z"
        stroke="currentColor"
        stroke-width="1.6"></path>
    </svg>
    <span>WhatsApp</span>
  </a>

  <a href="/#booking" class="action-item action-item-primary">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"></circle>
    </svg>
    <span>Book Service</span>
  </a>
</nav>

<style>
  .mobile-action-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 95;
    background: var(--navy-900);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .action-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    min-height: 60px;
    padding: 8px 4px;
    font-size: 11.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.82);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }

  .action-item:last-child {
    border-right: none;
  }

  .action-item svg {
    width: 20px;
    height: 20px;
  }

  .action-item-primary {
    background: var(--orange-500);
    color: #fff;
  }

  /* Only shown below the desktop nav breakpoint — the header CTA and the
     floating WhatsApp button cover these actions from 900px up. */
  @media (min-width: 900px) {
    .mobile-action-bar {
      display: none;
    }
  }

  /* Keep the bar from covering the end of the page's content. Scoped here
     since this component is the reason the extra space is needed. */
  :global(body) {
    padding-bottom: 60px;
  }

  @media (min-width: 900px) {
    :global(body) {
      padding-bottom: 0;
    }
  }
</style>
