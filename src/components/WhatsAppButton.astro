---
import { business, whatsappHref } from "../data/business";
---

<a
  href={whatsappHref(business.whatsappFloatingMessage)}
  class="whatsapp-float"
  target="_blank"
  rel="noopener"
  aria-label="Chat with SVPHome ARS on WhatsApp"
>
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path
      d="M17.5 14.4c-.3-.1-1.7-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.1.2-.3.3-.4.1-.2 0-.4 0-.5-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3 4.8 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.1-.2-.2-.5-.3z"
      fill="currentColor"></path>
    <path
      d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.5 5.3L2 22l4.8-1.5c1.5.9 3.3 1.3 5.2 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2z"
      stroke="currentColor"
      stroke-width="1.6"></path>
  </svg>
</a>

<style>
  .whatsapp-float {
    display: none;
    position: fixed;
    right: var(--sp-5);
    bottom: var(--sp-5);
    z-index: 90;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
    transition: transform 0.12s ease;
  }

  .whatsapp-float:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      transition: none;
    }
    .whatsapp-float:hover {
      transform: none;
    }
  }

  /* Shown from the same breakpoint the header switches to desktop nav —
     on mobile, the fixed action bar covers this action instead. */
  @media (min-width: 900px) {
    .whatsapp-float {
      display: flex;
    }
  }
</style>
