---
import type { BenefitIconName } from "../data/benefits";

interface Props {
  name: BenefitIconName;
}

const { name } = Astro.props;

// Same stroke-based icon language as the trust-band and appliance icons
// (currentColor, 1.6–1.8 stroke, 24x24 viewBox) so the new section reads as
// part of the same design system rather than a new visual style.
const paths: Record<BenefitIconName, string> = {
  "skilled-technicians": `
    <path d="M12 2l3 6 6 1-4.5 4.3L17.5 20 12 16.8 6.5 20l1-6.7L3 9l6-1 3-6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  `,
  "doorstep-convenience": `
    <path d="M3 10.5L12 4l9 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M5.5 9.5V19a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  `,
  "transparent-communication": `
    <path d="M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    <rect x="4" y="4" width="16" height="16" rx="2.5" stroke="currentColor" stroke-width="1.6"/>
    <path d="M8 8h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  `,
  "quality-parts": `
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/>
    <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  `,
  "convenient-scheduling": `
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/>
    <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  `,
  "multiple-appliances": `
    <rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.6"/>
  `,
};
---

<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={paths[name]} />
