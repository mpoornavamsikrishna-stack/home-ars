---
// Reusable nav link list. Rendered once for desktop (in a <nav>) and once
// inside the mobile drawer, so the link set only has to be maintained in
// src/data/business.ts.
import { navLinks } from "../data/business";

interface Props {
  variant?: "desktop" | "mobile";
}

const { variant = "desktop" } = Astro.props;
---

<ul class:list={["nav-list", variant === "mobile" && "nav-list-mobile"]}>
  {
    navLinks.map((link) => (
      <li>
        <a href={link.href} class:list={["nav-link", variant === "mobile" && "nav-link-mobile"]}>
          {link.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 14.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.82);
    padding: 8px 2px;
    border-bottom: 2px solid transparent;
    transition: color 0.12s ease, border-color 0.12s ease;
  }

  .nav-link:hover {
    color: #fff;
    border-bottom-color: var(--orange-500);
  }

  /* Mobile drawer variant: stacked, larger tap targets */
  .nav-list-mobile {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .nav-link-mobile {
    display: block;
    padding: var(--sp-4) 2px;
    font-size: 17px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    min-height: 44px;
  }
</style>
