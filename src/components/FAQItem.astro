---
interface Props {
  question: string;
  /** Plain text, or simple trusted HTML (e.g. an <a> tag) from src/data/faq.ts. */
  answer: string;
}

const { question, answer } = Astro.props;
---

<details class="faq-item">
  <summary class="faq-question">
    <span>{question}</span>
    <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <div class="faq-answer" set:html={answer} />
</details>

<style>
  .faq-item {
    background: var(--bg-white);
    border: 1px solid var(--line-200);
    border-radius: var(--radius-md);
    padding: var(--sp-4) var(--sp-5);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 15.5px;
    color: var(--navy-900);
    padding: var(--sp-1) 0;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--blue-600);
    transition: transform 0.15s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    margin-top: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line-200);
    font-size: 14.5px;
    color: var(--charcoal-600);
    line-height: 1.6;
  }

  .faq-answer :global(a) {
    color: var(--blue-600);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .faq-answer :global(a:hover) {
    color: var(--navy-900);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-chevron {
      transition: none;
    }
  }
</style>
