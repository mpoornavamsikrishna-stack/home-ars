---
import { services } from "../data/business";
import { telHref, whatsappHref } from "../data/business";
---

<section class="booking" id="booking" aria-labelledby="booking-heading">
  <div class="container booking-inner">
    <div class="booking-intro">
      <h2 id="booking-heading">Book an Appliance Repair Service</h2>
      <p class="booking-lede">
        Fill in the details below and SVPHome ARS will get back to you to confirm your appointment.
      </p>
    </div>

    <form class="booking-form" id="booking-form" data-tel-href={telHref()} data-whatsapp-href={whatsappHref()} novalidate>
      <div class="form-grid">
        <div class="form-field">
          <label for="fullName">Full Name <span class="required">*</span></label>
          <input type="text" id="fullName" name="fullName" autocomplete="name" required />
          <p class="field-error" id="fullName-error" role="alert"></p>
        </div>

        <div class="form-field">
          <label for="phone">Phone Number <span class="required">*</span></label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel" required />
          <p class="field-error" id="phone-error" role="alert"></p>
        </div>

        <div class="form-field">
          <label for="whatsapp">WhatsApp Number</label>
          <input type="tel" id="whatsapp" name="whatsapp" autocomplete="tel" inputmode="tel" />
          <p class="field-error" id="whatsapp-error" role="alert"></p>
        </div>

        <div class="form-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" />
          <p class="field-error" id="email-error" role="alert"></p>
        </div>

        <div class="form-field">
          <label for="applianceType">Appliance Type <span class="required">*</span></label>
          <select id="applianceType" name="applianceType" required>
            <option value="">Select an appliance</option>
            {services.map((s) => <option value={s.label}>{s.label}</option>)}
          </select>
          <p class="field-error" id="applianceType-error" role="alert"></p>
        </div>

        <div class="form-field">
          <label for="brand">Brand</label>
          <input type="text" id="brand" name="brand" />
          <p class="field-error" id="brand-error" role="alert"></p>
        </div>

        <div class="form-field">
          <label for="modelNumber">Model Number</label>
          <input type="text" id="modelNumber" name="modelNumber" />
          <p class="field-error" id="modelNumber-error" role="alert"></p>
        </div>

        <div class="form-field form-field-full">
          <label for="problemDescription">Problem Description <span class="required">*</span></label>
          <textarea id="problemDescription" name="problemDescription" rows="4" required></textarea>
          <p class="field-error" id="problemDescription-error" role="alert"></p>
        </div>

        <div class="form-field">
          <label for="preferredDate">Preferred Date</label>
          <input type="date" id="preferredDate" name="preferredDate" />
          <p class="field-error" id="preferredDate-error" role="alert"></p>
        </div>

        <div class="form-field">
          <label for="preferredTime">Preferred Time</label>
          <input type="time" id="preferredTime" name="preferredTime" />
          <p class="field-error" id="preferredTime-error" role="alert"></p>
        </div>

        <div class="form-field form-field-full">
          <div class="field-label-row">
            <label for="address">Address <span class="required">*</span></label>
            <button type="button" id="use-location-btn" class="use-location-link">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path
                  d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"></path>
                <circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.8"></circle>
              </svg>
              Use my current location
            </button>
          </div>
          <input type="text" id="address" name="address" autocomplete="street-address" required />
          <p class="field-error" id="address-error" role="alert"></p>
          <p class="location-status" id="location-status" role="status" aria-live="polite"></p>
        </div>

        <div class="form-field">
          <label for="areaCity">Area / City <span class="required">*</span></label>
          <input type="text" id="areaCity" name="areaCity" autocomplete="address-level2" required />
          <p class="field-error" id="areaCity-error" role="alert"></p>
        </div>

        <div class="form-field form-field-full">
          <label for="additionalNotes">Additional Notes</label>
          <textarea id="additionalNotes" name="additionalNotes" rows="3"></textarea>
          <p class="field-error" id="additionalNotes-error" role="alert"></p>
        </div>
      </div>

      <!-- Honeypot field — invisible to real visitors, but bots that
           auto-fill every input will trip it. Not a substitute for real
           server-side spam protection once a backend is connected. -->
      <div class="honeypot" aria-hidden="true">
        <label for="companyWebsite">Leave this field empty</label>
        <input type="text" id="companyWebsite" name="companyWebsite" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="btn btn-cta booking-submit">Request Service</button>

      <div class="form-status" id="form-status" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

<style>
  .booking {
    background: var(--bg-light);
    border-top: 1px solid var(--line-200);
    padding: var(--sp-8) 0;
    --form-error: #d64545;
  }

  .booking-inner {
    max-width: 820px;
  }

  .booking-intro {
    margin-bottom: var(--sp-6);
  }

  .booking-intro h2 {
    font-size: 28px;
    letter-spacing: -0.3px;
    margin-bottom: var(--sp-3);
  }

  .booking-lede {
    font-size: 15px;
    color: var(--charcoal-600);
  }

  .booking-form {
    background: var(--bg-white);
    border: 1px solid var(--line-200);
    border-radius: var(--radius-lg);
    padding: var(--sp-6);
    box-shadow: var(--shadow-sm);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-5);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .form-field-full {
    grid-column: 1 / -1;
  }

  .form-field label {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--navy-900);
    margin-bottom: var(--sp-2);
  }

  .field-label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .field-label-row label {
    margin-bottom: 0;
  }

  .use-location-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    padding: 0;
    margin-bottom: var(--sp-2);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--blue-600);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    min-height: 32px;
  }

  .use-location-link:hover {
    color: var(--navy-900);
  }

  .use-location-link:disabled {
    color: var(--charcoal-600);
    cursor: default;
    text-decoration: none;
  }

  .use-location-link svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .location-status {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--charcoal-600);
    min-height: 1em;
  }

  .location-status.is-error {
    color: var(--form-error);
  }

  .required {
    color: var(--form-error);
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body);
    /* 16px minimum — below this, iOS Safari auto-zooms the whole page in
       whenever this field is focused, which is what caused the reported
       "scaling" behavior on mobile, especially when combined with
       rotating the device while a field was focused. */
    font-size: 16px;
    color: var(--charcoal-900);
    background: var(--bg-white);
    border: 1.5px solid var(--line-200);
    border-radius: var(--radius-sm);
    padding: 11px 13px;
    min-height: 44px;
    transition: border-color 0.12s ease;
  }

  .form-field textarea {
    min-height: 44px;
    resize: vertical;
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-color: var(--blue-600);
  }

  .form-field input[aria-invalid="true"],
  .form-field select[aria-invalid="true"],
  .form-field textarea[aria-invalid="true"] {
    border-color: var(--form-error);
  }

  .field-error {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--form-error);
    min-height: 1em;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .booking-submit {
    margin-top: var(--sp-6);
    width: 100%;
  }

  @media (min-width: 640px) {
    .booking-submit {
      width: auto;
    }
  }

  .form-status {
    margin-top: var(--sp-5);
  }

  .form-status:empty {
    margin-top: 0;
  }

  .status-card {
    border-radius: var(--radius-md);
    padding: var(--sp-4);
    font-size: 14px;
    line-height: 1.6;
  }

  .status-success {
    background: var(--blue-100);
    border: 1px solid var(--blue-600);
    color: var(--navy-900);
  }

  .status-fallback {
    background: var(--bg-light);
    border: 1.5px dashed var(--line-200);
    color: var(--charcoal-600);
  }

  .status-fallback strong {
    display: block;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .status-fallback-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
  }

  @media (min-width: 700px) {
    .form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  // Minimal, dependency-free client-side validation + submission handling.
  // The only thing this script does beyond validation is call
  // submitBookingRequest() from src/lib/booking.ts — the single integration
  // point documented there. It never fabricates a "sent" state on its own.
  //
  // This is a real, statically-analyzable import (not define:vars +
  // dynamic import), so Vite bundles src/lib/booking.ts into a proper
  // hashed chunk instead of leaving an unresolved relative path in the
  // shipped HTML.
  import { submitBookingRequest } from "../lib/booking";

  (function () {
    const form = document.getElementById("booking-form") as HTMLFormElement | null;
    if (!form) return;

    const statusEl = document.getElementById("form-status");
    if (!statusEl) return;

    const telHref = form.dataset.telHref || "";
    const whatsappHref = form.dataset.whatsappHref || "";

    type FormControl = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

    const requiredFields: { id: string; label: string }[] = [
      { id: "fullName", label: "your full name" },
      { id: "phone", label: "a phone number" },
      { id: "applianceType", label: "the appliance type" },
      { id: "problemDescription", label: "a description of the problem" },
      { id: "address", label: "your address" },
      { id: "areaCity", label: "your area or city" },
    ];

    const emailField = document.getElementById("email") as HTMLInputElement | null;

    // "Use my current location" — asks the browser for GPS coordinates, then
    // reverse-geocodes them into a readable address via OpenStreetMap's free
    // Nominatim API (no account or API key needed). Falls back gracefully —
    // this never blocks typing the address in manually.
    const locationBtn = document.getElementById("use-location-btn") as HTMLButtonElement | null;
    const locationStatus = document.getElementById("location-status");
    const addressField = document.getElementById("address") as HTMLInputElement | null;
    const areaCityField = document.getElementById("areaCity") as HTMLInputElement | null;

    function setLocationStatus(message: string, isError = false) {
      if (!locationStatus) return;
      locationStatus.textContent = message;
      locationStatus.classList.toggle("is-error", isError);
    }

    if (locationBtn && addressField) {
      locationBtn.addEventListener("click", () => {
        if (!("geolocation" in navigator)) {
          setLocationStatus("Location isn't supported on this device/browser — please type your address.", true);
          return;
        }

        locationBtn.disabled = true;
        setLocationStatus("Locating you…");

        navigator.geolocation.getCurrentPosition(
          async (position) => {
            const { latitude, longitude } = position.coords;
            try {
              const res = await fetch(
                `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${latitude}&lon=${longitude}`,
                { headers: { Accept: "application/json" } }
              );
              if (!res.ok) throw new Error("reverse geocoding failed");
              const data = await res.json();

              if (data?.display_name) {
                addressField.value = data.display_name;
                setError("address", "");
              }

              const addr = data?.address ?? {};
              const areaCity = addr.suburb || addr.neighbourhood || addr.city || addr.town || addr.village;
              if (areaCityField && areaCity) {
                areaCityField.value = areaCity;
                setError("areaCity", "");
              }

              setLocationStatus("Location found — please double-check the address below.");
            } catch {
              setLocationStatus(
                "Couldn't look up an address for your location — please enter it manually.",
                true
              );
            } finally {
              locationBtn.disabled = false;
            }
          },
          (error) => {
            locationBtn.disabled = false;
            const message =
              error.code === error.PERMISSION_DENIED
                ? "Location access was denied — please enter your address manually."
                : "Couldn't get your location — please enter your address manually.";
            setLocationStatus(message, true);
          },
          { timeout: 10000 }
        );
      });
    }

    function setError(fieldId: string, message: string) {
      const input = document.getElementById(fieldId);
      const errorEl = document.getElementById(`${fieldId}-error`);
      if (input) input.setAttribute("aria-invalid", message ? "true" : "false");
      if (errorEl) errorEl.textContent = message || "";
    }

    function validate(): boolean {
      let firstInvalid: FormControl | null = null;
      let isValid = true;

      requiredFields.forEach(({ id, label }) => {
        const input = document.getElementById(id) as FormControl | null;
        const value = input ? input.value.trim() : "";
        if (!value) {
          setError(id, `Please enter ${label}.`);
          isValid = false;
          firstInvalid = firstInvalid || input;
        } else {
          setError(id, "");
        }
      });

      if (emailField && emailField.value.trim()) {
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(emailField.value.trim())) {
          setError("email", "Please enter a valid email address.");
          isValid = false;
          firstInvalid = firstInvalid || emailField;
        } else {
          setError("email", "");
        }
      }

      if (firstInvalid) (firstInvalid as FormControl).focus();
      return isValid;
    }

    form.addEventListener("submit", async function (event) {
      event.preventDefault();

      // Honeypot: if this hidden field has a value, silently drop the
      // submission — a real visitor would never fill it in.
      const honeypot = document.getElementById("companyWebsite") as HTMLInputElement | null;
      if (honeypot && honeypot.value.trim()) return;

      if (!validate()) return;

      const data = new FormData(form);
      const payload = {
        fullName: data.get("fullName")?.toString().trim() ?? "",
        phone: data.get("phone")?.toString().trim() ?? "",
        whatsapp: data.get("whatsapp")?.toString().trim() ?? "",
        email: data.get("email")?.toString().trim() ?? "",
        applianceType: data.get("applianceType")?.toString().trim() ?? "",
        brand: data.get("brand")?.toString().trim() ?? "",
        modelNumber: data.get("modelNumber")?.toString().trim() ?? "",
        problemDescription: data.get("problemDescription")?.toString().trim() ?? "",
        preferredDate: data.get("preferredDate")?.toString().trim() ?? "",
        preferredTime: data.get("preferredTime")?.toString().trim() ?? "",
        address: data.get("address")?.toString().trim() ?? "",
        areaCity: data.get("areaCity")?.toString().trim() ?? "",
        additionalNotes: data.get("additionalNotes")?.toString().trim() ?? "",
      };

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }

      const result = await submitBookingRequest(payload);

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Request Service";
      }

      if (result.success) {
        statusEl.innerHTML =
          '<div class="status-card status-success">Thank you! Your service request has been received. SVPHome ARS will contact you shortly.</div>';
        form.reset();
      } else {
        // No backend is connected yet — be upfront about that rather than
        // claiming the request went through, and offer a channel that
        // actually works right now.
        statusEl.innerHTML = `
          <div class="status-card status-fallback">
            <strong>This form isn't connected to a booking system yet.</strong>
            Please call or WhatsApp us directly and we'll get your request sorted.
            <div class="status-fallback-actions">
              <a href="${telHref}" class="btn btn-outline-navy btn-sm">Call Now</a>
              <a href="${whatsappHref}" class="btn btn-ghost-blue btn-sm" target="_blank" rel="noopener">WhatsApp Us</a>
            </div>
          </div>
        `;
      }

      statusEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  })();
</script>
