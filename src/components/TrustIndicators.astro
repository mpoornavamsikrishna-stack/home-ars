---
import { trustIndicators } from "../data/business";

// Simple, distinct icon per indicator (index-matched to trustIndicators in
// src/data/business.ts). Kept inline so no image requests are needed.
const icons = [
  `<path d="M12 2l3 6 6 1-4.5 4.3L17.5 20 12 16.8 6.5 20l1-6.7L3 9l6-1 3-6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`,
  `<path d="M3 10.5L12 4l9 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 9.5V19a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
  `<path d="M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><rect x="4" y="4" width="16" height="16" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M8 8h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  `<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>`,
  `<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>`,
  `<rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.6"/>`,
];
---

<section class="trust-band" aria-labelledby="trust-heading">
  <div class="container">
    <h2 id="trust-heading" class="visually-hidden">Why choose SVPHome ARS</h2>

    <div class="trust-grid">
      {
        trustIndicators.map((item, i) => (
          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={icons[i]} />
            </span>
            <div class="trust-text">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .trust-band {
    background: var(--bg-light);
    border-bottom: 1px solid var(--line-200);
    padding: var(--sp-6) 0;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
  }

  .trust-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--bg-white);
    border: 1px solid var(--line-200);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .trust-icon svg {
    width: 20px;
    height: 20px;
    color: var(--blue-600);
  }

  .trust-text h3 {
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 700;
    color: var(--navy-900);
  }

  .trust-text p {
    font-size: 13px;
    color: var(--charcoal-600);
    margin-top: 2px;
  }

  @media (min-width: 640px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 980px) {
    .trust-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .trust-item {
      border-right: 1px dashed var(--line-200);
      padding-right: var(--sp-4);
    }
    .trust-item:nth-child(3n) {
      border-right: none;
    }
  }

  @media (min-width: 1180px) {
    .trust-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .trust-item:nth-child(3n) {
      border-right: 1px dashed var(--line-200);
    }
    .trust-item:nth-child(6n) {
      border-right: none;
    }
  }
</style>
