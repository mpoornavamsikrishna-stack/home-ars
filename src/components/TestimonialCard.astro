---
interface Props {
  verified: boolean;
  customerName: string;
  applianceServiced: string;
  review: string;
  rating: number | null;
}

const { verified, customerName, applianceServiced, review, rating } = Astro.props;
---

<article class:list={["testimonial-card", !verified && "testimonial-placeholder"]}>
  {
    !verified && (
      <span class="placeholder-badge">Placeholder — awaiting verified review</span>
    )
  }

  {
    verified && rating !== null && (
      <div class="testimonial-rating" aria-label={`Rated ${rating} out of 5 stars`}>
        {Array.from({ length: 5 }).map((_, i) => (
          <svg
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            fill={i < rating ? "currentColor" : "none"}
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path d="M12 2l3 6 6 1-4.5 4.3L17.5 20 12 16.8 6.5 20l1-6.7L3 9l6-1 3-6z" stroke-linejoin="round" />
          </svg>
        ))}
      </div>
    )
  }

  <p class="testimonial-review">{review}</p>

  <div class="testimonial-meta">
    <span class="testimonial-name">{customerName}</span>
    <span class="testimonial-appliance">{applianceServiced}</span>
  </div>
</article>

<style>
  .testimonial-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-white);
    border: 1px solid var(--line-200);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
    box-shadow: var(--shadow-sm);
  }

  .testimonial-placeholder {
    background: var(--bg-light);
    border: 1.5px dashed var(--line-200);
    box-shadow: none;
  }

  .placeholder-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--blue-600);
    background: var(--blue-100);
    border-radius: 999px;
    padding: 4px 10px;
    margin-bottom: var(--sp-3);
  }

  .testimonial-rating {
    display: flex;
    gap: 3px;
    margin-bottom: var(--sp-3);
  }

  .testimonial-rating svg {
    width: 16px;
    height: 16px;
    color: var(--orange-500);
  }

  .testimonial-review {
    font-size: 14.5px;
    color: var(--charcoal-600);
    margin-bottom: var(--sp-4);
    flex-grow: 1;
  }

  .testimonial-placeholder .testimonial-review {
    font-style: italic;
  }

  .testimonial-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line-200);
  }

  .testimonial-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--navy-900);
  }

  .testimonial-placeholder .testimonial-name,
  .testimonial-placeholder .testimonial-appliance {
    font-style: italic;
    color: var(--charcoal-600);
    font-weight: 600;
  }

  .testimonial-appliance {
    font-size: 12.5px;
    color: var(--charcoal-600);
  }
</style>
