---
import type { ApplianceIconName } from "../data/services";

interface Props {
  name: ApplianceIconName;
}

const { name } = Astro.props;

// Inline SVG paths, one per appliance. Kept in the same stroke-based style as
// the trust indicator icons (currentColor, 1.6 stroke) so new icons stay
// visually consistent without extra image requests.
const paths: Record<ApplianceIconName, string> = {
  "washing-machine": `
    <rect x="4" y="3" width="16" height="18" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M7 6h.01M10 6h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <circle cx="12" cy="13" r="5" stroke="currentColor" stroke-width="1.6"/>
    <path d="M9.8 12c.6 1.2 2.8 1.2 3.4-.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/>
  `,
  refrigerator: `
    <rect x="6" y="2.5" width="12" height="19" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M6 9.5h12" stroke="currentColor" stroke-width="1.6"/>
    <path d="M9 5.5v2M9 12v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
  `,
  ac: `
    <rect x="3" y="6" width="18" height="7" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M6 16l-1.2 3M11 16.5l-.6 3.2M16 16l1.2 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M6.5 9.5h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  `,
  microwave: `
    <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <rect x="5.5" y="7.5" width="10" height="9" rx="1.2" stroke="currentColor" stroke-width="1.4"/>
    <circle cx="18.3" cy="10" r="0.9" fill="currentColor"/>
    <path d="M17 13.5h2.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  `,
  tv: `
    <rect x="3" y="4.5" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M9 20h6M12 16.5V20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  `,
  other: `
    <path d="M7 3v4M11 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M5.5 7h7v3a3.5 3.5 0 0 1-3.5 3.5A3.5 3.5 0 0 1 5.5 10V7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    <path d="M9 13.5V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M16 9.5v8a2 2 0 0 0 2 2 2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  `,
};
---

<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={paths[name]} />
